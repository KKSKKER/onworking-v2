{
  "name": "onworking",
  "version": "0.2.0",
  "description": "AI 数据工作的透明执行框架 — V2",
  "author": "KKSKKER",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:import": "tsx scripts/demo-import.ts",
    "demo:agent": "tsx scripts/agent-flow-demo.ts",
    "test:mcp": "tsx scripts/mcp-client-test.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "rebuild:node": "npm rebuild better-sqlite3",
    "build:dual-abi": "tsx scripts/build-dual-abi.ts",
    "dev": "npm run build:main && concurrently -k \"vite --port 5173 --strict-port\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite --port 5173 --strict-port",
    "start": "npm run build && electron .",
    "onw": "tsx src/cli/index.ts",
    "onw:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron dist/main/cli/index.js",
    "postinstall": "node scripts/postinstall-dual-abi.js",
    "dist": "npm run build:dual-abi && npm run build && electron-builder",
    "release": "npm run build:dual-abi && npm run build && electron-builder"
  },
  "bin": {
    "onw": "dist/main/cli/index.js"
  },
  "build": {
    "appId": "com.onworking.app",
    "productName": "Onworking",
    "files": ["dist/**", "node_modules/better-sqlite3-electron/**"],
    "asar": false,
    "asarUnpack": ["dist/main/**", "node_modules/better-sqlite3-electron/**"],
    "directories": { "output": "release" },
    "extraFiles": [{ "from": "agents.md", "to": "." }],
    "win": { "target": ["nsis", "portable"] },
    "npmRebuild": false
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "better-sqlite3-electron": "11.10.0",
    "dockview-react": "^8.2.0",
    "js-yaml": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  }
}
