{
  "name": "onworking",
  "version": "0.2.0",
  "description": "AI 数据工作的透明执行框架 — V2",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:import": "tsx scripts/demo-import.ts",
    "demo:agent": "tsx scripts/agent-flow-demo.ts",
    "test:mcp": "tsx scripts/mcp-client-test.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dev": "npm run rebuild:node && npm run build:main && concurrently -k \"vite --port 5173 --strict-port\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite --port 5173 --strict-port",
    "start": "npm run rebuild:node && npm run build && electron .",
    "onw": "tsx src/cli/index.ts"
  },
  "bin": {
    "onw": "dist/main/cli/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dockview-react": "^8.2.0",
    "js-yaml": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.0"
  }
}
