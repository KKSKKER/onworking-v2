{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "dist/main",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/main", "src/ipc", "src/core", "src/app", "src/cli", "src/mcp"]
}
